generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  createdAt        DateTime  @default(now())
  dailyTargetCount Int       @default(10)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActiveDate   DateTime?
  scheduler        String    @default("sm2")
  requestRetention Float     @default(0.9)

  sessions     Session[]
  memoryStates UserMemoryState[]
  reviewLogs   ReviewLog[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Surah {
  id              Int    @id
  nameArabic      String
  nameSimple      String
  englishName     String
  revelationPlace String
  ayahCount       Int

  @@index([nameSimple])
}

model Verse {
  verseKey       String   @id
  surahId        Int
  ayahNumber     Int
  pageNumber     Int
  uthmaniText    String
  translation    String
  audioUrl       String
  timestampsJson String
  wordsJson      String?
  wordsSource    String   @default("synthetic")
  recitationUrl  String?
  tafsir         String?
  createdAt      DateTime @default(now())

  memoryStates UserMemoryState[]
  reviewLogs   ReviewLog[]

  @@index([surahId])
}

model UserMemoryState {
  id              String    @id @default(cuid())
  userId          String
  verseKey        String
  state           String
  intervalDays    Float     @default(0)
  easeFactor      Float     @default(2.5)
  repetitionCount Int       @default(0)
  lapses          Int       @default(0)
  difficulty      Float?
  stability       Float?
  dueDate         DateTime  @default(now())
  lastReviewedAt  DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse Verse @relation(fields: [verseKey], references: [verseKey], onDelete: Cascade)

  @@unique([userId, verseKey])
  @@index([userId, dueDate])
  @@index([userId, state])
}

model RecitationAudio {
  id        String @id @default(cuid())
  verseKey  String
  reciterId Int
  url       String

  @@unique([verseKey, reciterId])
  @@index([reciterId])
}

model ReviewLog {
  id              String   @id @default(cuid())
  userId          String
  verseKey        String
  grade           String
  quality         Int
  intervalDays    Float
  easeFactorAfter Float
  difficultyAfter Float?
  stabilityAfter  Float?
  scheduler       String
  reviewDurationMs Int     @default(0)
  createdAt       DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verse Verse @relation(fields: [verseKey], references: [verseKey], onDelete: Cascade)

  @@index([userId, createdAt])
}
